# Supabase — copy to .env.local and fill with your project values.
# Project Settings → API Keys (new keys) + Project Settings → API (URL).

# Public: safe to expose in the browser. Respects Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=<your-project-url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Secret: SERVER ONLY. Bypasses RLS. Never commit, never expose to the browser.
SUPABASE_SECRET_KEY=<your-secret-key>
